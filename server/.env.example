PORT=4000
GEOAPIFY_API_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ridematch
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ridematch_test
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
OFFER_TIMEOUT_SECONDS=15
MAX_ATTEMPTS=3
SEARCH_RADIUS_KM=5
AVG_SPEED_KMH=25
RANKER=nearest
RANKER_WEIGHTS={}
FAIR_DISPATCH_ENABLED=true
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=2500
# Retained for compatibility with existing deployments; fares use the vehicle schedule in fare.js.
FARE_BASE=50
FARE_PER_KM=12
FARE_VEHICLE_MULTIPLIER={"AUTO":0.8,"HATCHBACK":1.0,"SEDAN":1.2,"SUV":1.5}
DRIVER_PAYOUT_PERCENT=0.80
FARE_MULTIPLIER_MIN=0.5
FARE_MULTIPLIER_MAX=2.0
STALE_HEARTBEAT_SECONDS=0
DEMO_MODE=true
SERVICE_API_KEY=dev-service-key
CITY_CENTER_LAT=15.8497
CITY_CENTER_LNG=74.4977
TRAFFIC_PREDICTION_ENABLED=true
INCIDENT_DEDUPE_RADIUS_METERS=300
EMERGENCY_ROUTE_ENABLED=true
